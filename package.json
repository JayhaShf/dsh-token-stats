{
  "name": "dsh-token-stats",
  "description": "Token 用量统计（双面插件）：宿主侧从会话日志捕获提供方上报的 token 用量（assistant/chunk usage，assistant/message 兜底）并持久化为 JSONL，浏览器侧在设置页提供累计 / 今日 / 按模型 / 按天 / 日期区间统计面板，另注册 token_stats 模型工具。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test-selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayhaShf/dsh-token-stats.git"
  },
  "homepage": "https://github.com/JayhaShf/dsh-token-stats",
  "bugs": {
    "url": "https://github.com/JayhaShf/dsh-token-stats/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
